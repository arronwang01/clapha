+    def queue_hand_action_next_tick(self, action: HandAction) -> dict[str, Any]:
+        """Queue a model play for the next tick without a live-render clock race.
+
+        clapha (2026-10-02, after upstream's method of the same name): with CR_AI_NO_DELAY the AI's
+        card goes in on the next tick, but the stock renderer keeps running while the request is
+        made, and on a busy machine the tick passed first -- queue_hand_action_at raised and the
+        whole match ended mid-game. Holding the renderer for the queueing removes the race; a
+        renderer the user had paused stays paused.
+        """
+
+        with self._lock:
+            was_paused = bool(self.status().get("paused"))
+            if not was_paused:
+                self.pause()
+            try:
+                return self.queue_hand_action_at(action, execute_in_ticks=1)
+            finally:
+                if not was_paused:
+                    self.resume()
 
